# Test harness for just-plug. Run with: just -f tests/justfile test

test: unit integration

unit:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{justfile_directory()}}"
    fail=0
    for t in unit/test_*.sh; do
        echo "=== $t ==="
        bash "$t" || fail=1
    done
    exit $fail

integration:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{justfile_directory()}}"
    fail=0
    for t in integration/test_*.sh; do
        echo "=== $t ==="
        bash "$t" || fail=1
    done
    exit $fail

smoke:
    @echo "just-plug skeleton OK"
